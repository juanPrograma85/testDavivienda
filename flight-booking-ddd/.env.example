# ---- Runtime ----
NODE_ENV=development
PORT=3000

# ---- Persistence ----
# PostgreSQL is the source of truth for every bounded context.
DATABASE_URL=postgresql://flight_booking:change-me@localhost:5432/flight_booking

# ---- Security ----
# Comma separated list of allowed origins for CORS. Use explicit origins in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Shared secret required by administrative endpoints (flight status changes).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-with-a-32-byte-random-hex
# Requests allowed per IP within the TTL window (milliseconds).
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# ---- Seat inventory ----
# Temporary seat hold duration in seconds (business rule: 5-10 minutes).
SEAT_HOLD_TTL_SECONDS=420
